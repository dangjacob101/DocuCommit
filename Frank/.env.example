DATABASE_URL=sqlite:///documents.db
SECRET_KEY=change-me-in-production
DEBUG=true

# Flask dev server port. Default is 5000.
# macOS users: AirPlay Receiver squats :5000 by default — uncomment the line
# below (or pick another free port) and set VITE_API_TARGET in client/.env.local
# to match. See SETUP.md.
# PORT=5001
